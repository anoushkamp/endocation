---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');

  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{article.data.title} | Endocation</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>

    <header class="site-header">
      <a href="/" class="brand">
        <img
          src="/endocation-logo.png"
          alt="Endocation logo"
          class="brand-logo"
        />
        <span>ENDOCATION</span>
      </a>

      <nav>
        <a href="/research">Latest Research</a>
        <a href="/#basics">Endometriosis 101</a>
        <a href="/#advocate">Advocate</a>
        <a href="/#about">About</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>

    <main>
      <article class="article-page">

        <a href="/research" class="back-link">← ALL RESEARCH</a>

        <div class="article-meta">
          <span>{article.data.category}</span>
          <span>{article.data.readTime}</span>
        </div>

        <h1>{article.data.title}</h1>

        <div class="article-details">
          <span>{article.data.journal}</span>

          <span>
            {article.data.date.toLocaleDateString('en-GB', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })}
          </span>
        </div>

        <div class="article-body">
          <Content />
        </div>

      </article>
    </main>

    <footer>
      <div>
        <strong>ENDOCATION</strong>
        <p>Research translated. Your health shouldn't be complicated.</p>
      </div>

      <p>
        Educational content only. Endocation does not provide individual
        medical advice.
      </p>
    </footer>

  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #fffaf2;
    color: #261235;
    font-family: "Manrope", sans-serif;
  }

  :global(a) {
    color: inherit;
  }

  .site-header {
    width: min(1400px, calc(100% - 64px));
    margin: 0 auto;
    min-height: 90px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.05em;
  }

  .brand-logo {
    width: 48px;
    height: 48px;
    object-fit: contain;
    border-radius: 50%;
  }

  nav {
    display: flex;
    gap: 30px;
  }

  nav a {
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }

  nav a:hover {
    color: #7a2cff;
  }

  .article-page {
    width: min(1100px, calc(100% - 64px));
    margin: 0 auto;
    padding: 100px 0 140px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 70px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-decoration: none;
  }

  .back-link:hover {
    color: #7a2cff;
  }

  .article-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 35px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7a2cff;
  }

  h1 {
    max-width: 1050px;
    margin: 0;
    font-size: clamp(3.5rem, 7vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.065em;
  }

  .article-details {
    display: flex;
    justify-content: space-between;
    gap: 25px;
    margin-top: 45px;
    padding: 25px 0;
    border-top: 2px solid #d7c4ff;
    border-bottom: 2px solid #d7c4ff;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .article-body {
    max-width: 760px;
    margin: 75px auto 0;
    font-size: 1.08rem;
    line-height: 1.85;
  }

  .article-body :global(h2) {
    margin: 75px 0 24px;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.12;
    letter-spacing: -0.045em;
  }

  .article-body :global(h2:first-child) {
    margin-top: 0;
  }

  .article-body :global(p) {
    margin: 0 0 26px;
  }

  .article-body :global(strong) {
    font-weight: 800;
  }

  .article-body :global(a) {
    color: #7a2cff;
    font-weight: 700;
    text-underline-offset: 4px;
  }

  .article-body :global(blockquote) {
    margin: 50px 0;
    padding: 30px;
    background: #f0eaff;
    border-radius: 20px;
    font-size: 1.25rem;
    font-weight: 650;
    line-height: 1.6;
  }

  footer {
    padding: 55px max(32px, calc((100% - 1400px) / 2));
    background: #261235;
    color: white;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }

  footer strong {
    color: #f1ff38;
  }

  footer p {
    margin: 8px 0 0;
    max-width: 500px;
    font-size: 0.8rem;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    nav {
      display: none;
    }

    .site-header {
      width: calc(100% - 40px);
    }

    .article-page {
      width: calc(100% - 40px);
      padding-top: 60px;
    }

    .article-details {
      flex-direction: column;
      gap: 8px;
    }

    footer {
      grid-template-columns: 1fr;
    }
  }
</style>